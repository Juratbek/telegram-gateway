{
  "name": "@deployed/telegram-gateway",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Telegram Gateway API — send and verify OTP codes via Telegram",
  "type": "module",
  "main": "./dist/telegram-gateway.cjs",
  "module": "./dist/telegram-gateway.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/telegram-gateway.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/telegram-gateway.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "telegram",
    "gateway",
    "otp",
    "verification",
    "sms",
    "2fa",
    "auth",
    "telegram-gateway"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
